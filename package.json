  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish",
    "lint": "tsc --noEmit -p ./",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && node --require ./test/unit/setup.js --test test/unit/*.test.js",
    "check": "npm run lint && npm run test:unit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "verify:marketplace": "npm run check && node scripts/verify-marketplace.js && npx --yes @vscode/vsce ls",
    "package:marketplace": "npm run check && node scripts/verify-marketplace.js && npx --yes @vscode/vsce package --allow-missing-repository",
    "publish:marketplace": "npm run check && node scripts/verify-marketplace.js && npx --yes @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#101827",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aleff-github/crypto-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/aleff-github/crypto-toolkit/issues"
  },
  "homepage": "https://github.com/aleff-github/crypto-toolkit#readme",
  "extensionKind": [
    "workspace"
  ]
}
