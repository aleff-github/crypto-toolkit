{
  "name": "crypto-toolkit",
  "displayName": "Crypto Toolkit",
  "description": "Offline cryptography, encoding, hashing, JWT, AES, HMAC and developer utility toolkit for VS Code.",
  "version": "1.0.0",
  "publisher": "aleff",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "crypto",
    "cryptography",
    "base64",
    "hash",
    "jwt",
    "aes",
    "offline",
    "smart-detect",
    "encoding",
    "vscode",
    "uuid",
    "random",
    "local"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Crypto Toolkit",
      "properties": {
        "cryptoToolkit.outputMode": {
          "type": "string",
          "default": "replace",
          "enum": [
            "replace",
            "insert",
            "sidePanel",
            "clipboard"
          ],
          "enumDescriptions": [
            "Replace the current selection with the operation result.",
            "Insert the operation result below the current selection.",
            "Open the operation result in a readonly side panel.",
            "Copy the operation result to the clipboard."
          ],
          "description": "Controls where operation results are written."
        },
        "cryptoToolkit.preferredEncoding": {
          "type": "string",
          "default": "utf8",
          "enum": [
            "utf8",
            "hex",
            "base64"
          ],
          "description": "Default encoding used when prompts need to decode keys, secrets, IVs, or binary values."
        },
        "cryptoToolkit.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show concise success/warning notifications after operations."
        },
        "cryptoToolkit.autoCopyResults": {
          "type": "boolean",
          "default": false,
          "description": "Also copy successful operation results to the clipboard, regardless of output mode."
        },
        "cryptoToolkit.randomTokenBytes": {
          "type": "number",
          "default": 32,
          "minimum": 8,
          "maximum": 4096,
          "description": "Default byte length for random token generation."
        },
        "cryptoToolkit.smartDecode.minimumConfidence": {
          "type": "number",
          "default": 45,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum confidence required for Smart Decode candidates. Increase it to reduce false positives."
        },
        "cryptoToolkit.smartDecode.maxCandidates": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of Smart Decode candidates shown in QuickPick or reports."
        },
        "cryptoToolkit.smartDecode.showLowConfidence": {
          "type": "boolean",
          "default": false,
          "description": "Show low-confidence Smart Decode candidates. Useful while debugging detectors, but noisier."
        },
        "cryptoToolkit.smartDecode.includeReasons": {
          "type": "boolean",
          "default": true,
          "description": "Include scoring reasons in Smart Decode reports and candidate outputs."
        }
      }
    },
    "submenus": [
      {
        "id": "cryptoToolkit.menu.root",
        "label": "Crypto"
      },
      {
        "id": "cryptoToolkit.menu.smart",
        "label": "Smart"
      },
      {
        "id": "cryptoToolkit.menu.encode",
        "label": "Encode"
      },
      {
        "id": "cryptoToolkit.menu.decode",
        "label": "Decode"
      },
      {
        "id": "cryptoToolkit.menu.hash",
        "label": "Hash"
      },
      {
        "id": "cryptoToolkit.menu.hmac",
        "label": "HMAC"
      },
      {
        "id": "cryptoToolkit.menu.jwt",
        "label": "JWT"
      },
      {
        "id": "cryptoToolkit.menu.aes",
        "label": "AES"
      },
      {
        "id": "cryptoToolkit.menu.utility",
        "label": "Utility"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cryptoToolkit.menu.root",
          "group": "navigation@10",
          "when": "editorTextFocus"
        }
      ],
      "cryptoToolkit.menu.root": [
        {
          "submenu": "cryptoToolkit.menu.smart",
          "group": "0_smart@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.encode",
          "group": "1_encode@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.decode",
          "group": "1_encode@2",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.hash",
          "group": "2_crypto@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.hmac",
          "group": "2_crypto@2",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.jwt",
          "group": "3_tokens@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.aes",
          "group": "4_symmetric@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "cryptoToolkit.menu.utility",
          "group": "9_utility@1"
        }
      ],
      "cryptoToolkit.menu.smart": [
        {
          "command": "cryptoToolkit.smart.detectAndDecode",
          "group": "1_detect@1"
        }
      ],
      "cryptoToolkit.menu.encode": [
        {
          "command": "cryptoToolkit.encode.base64",
          "group": "1_encoding@1"
        },
        {
          "command": "cryptoToolkit.encode.base64url",
          "group": "1_encoding@2"
        },
        {
          "command": "cryptoToolkit.encode.hex",
          "group": "1_encoding@3"
        },
        {
          "command": "cryptoToolkit.encode.url",
          "group": "2_web@1"
        },
        {
          "command": "cryptoToolkit.encode.html",
          "group": "2_web@2"
        }
      ],
      "cryptoToolkit.menu.decode": [
        {
          "command": "cryptoToolkit.decode.base64",
          "group": "1_encoding@1"
        },
        {
          "command": "cryptoToolkit.decode.base64url",
          "group": "1_encoding@2"
        },
        {
          "command": "cryptoToolkit.decode.hex",
          "group": "1_encoding@3"
        },
        {
          "command": "cryptoToolkit.decode.url",
          "group": "2_web@1"
        },
        {
          "command": "cryptoToolkit.decode.html",
          "group": "2_web@2"
        }
      ],
      "cryptoToolkit.menu.hash": [
        {
          "command": "cryptoToolkit.hash.md5",
          "group": "1_hash@1"
        },
        {
          "command": "cryptoToolkit.hash.sha1",
          "group": "1_hash@2"
        },
        {
          "command": "cryptoToolkit.hash.sha256",
          "group": "2_sha2@1"
        },
        {
          "command": "cryptoToolkit.hash.sha512",
          "group": "2_sha2@2"
        }
      ],
      "cryptoToolkit.menu.hmac": [
        {
          "command": "cryptoToolkit.hmac.sha256",
          "group": "1_hmac@1"
        },
        {
          "command": "cryptoToolkit.hmac.sha384",
          "group": "1_hmac@2"
        },
        {
          "command": "cryptoToolkit.hmac.sha512",
          "group": "1_hmac@3"
        }
      ],
      "cryptoToolkit.menu.jwt": [
        {
          "command": "cryptoToolkit.jwt.decode",
          "group": "1_decode@1"
        }
      ],
      "cryptoToolkit.menu.aes": [
        {
          "command": "cryptoToolkit.aes.cbcEncrypt",
          "group": "1_cbc@1"
        },
        {
          "command": "cryptoToolkit.aes.cbcDecrypt",
          "group": "1_cbc@2"
        },
        {
          "command": "cryptoToolkit.aes.gcmEncrypt",
          "group": "2_gcm@1"
        },
        {
          "command": "cryptoToolkit.aes.gcmDecrypt",
          "group": "2_gcm@2"
        }
      ],
      "cryptoToolkit.menu.utility": [
        {
          "command": "cryptoToolkit.utility.jsonPretty",
          "group": "1_json@1",
          "when": "editorHasSelection"
        },
        {
          "command": "cryptoToolkit.utility.jsonMinify",
          "group": "1_json@2",
          "when": "editorHasSelection"
        },
        {
          "command": "cryptoToolkit.utility.unixDecode",
          "group": "2_time@1",
          "when": "editorHasSelection"
        },
        {
          "command": "cryptoToolkit.utility.unixEncode",
          "group": "2_time@2"
        },
        {
          "command": "cryptoToolkit.utility.uuidGenerate",
          "group": "3_generate@1"
        },
        {
          "command": "cryptoToolkit.utility.randomHex",
          "group": "3_generate@2"
        },
        {
          "command": "cryptoToolkit.utility.randomBase64",
          "group": "3_generate@3"
        },
        {
          "command": "cryptoToolkit.utility.sortLines",
          "group": "4_lines@1",
          "when": "editorHasSelection"
        },
        {
          "command": "cryptoToolkit.utility.uniqueLines",
          "group": "4_lines@2",
          "when": "editorHasSelection"
        }
      ]
    },
    "commands": [
      {
